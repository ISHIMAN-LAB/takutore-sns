# ローカルテスト用 (本番は GitHub Actions Secrets を使用)
# cp .env.example .env して実値を入れる

# ---- Meta アプリ (FB/IG 共通) ----
FB_APP_ID=1470442400955331
FB_APP_SECRET=

# ---- Instagram Business ----
IG_USER_ID=17841423440462973
IG_ACCESS_TOKEN=
# refresh_token.py が自動更新する有効期限 (ISO8601 UTC)
IG_TOKEN_EXPIRES_AT=

# ---- Facebook Page ----
FB_PAGE_ID=109095650463255
# Page tokens は永続 (expires_at=0) なので更新不要だが、
# IG_ACCESS_TOKEN が完全失効するとこちらも連動失効する
FB_PAGE_ACCESS_TOKEN=

# 画像をホストする base URL (poster.py 経由の場合のみ必要)
# 例: https://raw.githubusercontent.com/ISHIMAN-LAB/takutore-sns/main
# 注意: PRIVATE リポジトリでは IG が画像 fetch できない → PUBLIC repo か別ホストが必要
IMAGE_BASE_URL=

# ---- X (Twitter) — 未セットアップ ----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---- プラットフォーム個別 ON/OFF (poster.py で使用) ----
ENABLE_X=false
ENABLE_FB=true
ENABLE_IG=true

# 初期テスト用: 投稿せずログだけ出す
DRY_RUN=true
